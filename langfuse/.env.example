# Copy is NOT enough — run ./setup.sh 192.168.0.100 instead.
# ENCRYPTION_KEY must be exactly 64 hex chars (openssl rand -hex 32).
# NEXTAUTH_SECRET must be openssl rand -base64 32.
# Placeholder text like "change-me" will cause HTTP 500 errors.

NEXTAUTH_URL=http://192.168.0.100:3000
NEXTAUTH_SECRET=REPLACE_WITH_openssl_rand_base64_32
ENCRYPTION_KEY=REPLACE_WITH_openssl_rand_hex_32
SALT=REPLACE_WITH_openssl_rand_base64_32
POSTGRES_PASSWORD=postgres
CLICKHOUSE_PASSWORD=clickhouse
REDIS_AUTH=myredissecret
MINIO_ROOT_PASSWORD=miniosecret
TELEMETRY_ENABLED=false
