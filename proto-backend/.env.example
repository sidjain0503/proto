# Server
PORT=8080
ENVIRONMENT=local

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=proto

# Auth (generate a strong secret for production)
SECURITY_TOKEN_LIFE=8h
SECURITY_TOKEN_SECRET=change-me-to-a-long-random-secret

# CORS — comma-separated frontend origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# AI Providers (configure at least one)
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OLLAMA_BASE_URL=http://localhost:11434

# Swagger docs (optional — if unset, /api-docs is open)
API_DOC_USER=
API_DOC_PASSWORD=

# Logging
LOG_LEVEL=debug

# Langfuse observability (optional)
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_TRACING_ENVIRONMENT=local
