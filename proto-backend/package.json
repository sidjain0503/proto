{
  "name": "proto-backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "security:check": "node scripts/security-check.js",
    "db:ensure": "node scripts/ensure-db.js",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "db:setup": "npm run db:ensure && npm run db:migrate && npm run db:seed",
    "test": "node --require ./tests/setup.js --test --test-force-exit tests/contract/*.test.js tests/unit/*.test.js",
    "test:watch": "node --require ./tests/setup.js --watch --test tests/contract/*.test.js tests/unit/*.test.js"
  },
