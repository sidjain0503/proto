    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^8.3.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "nodemon": "^3.1.10",
    "supertest": "^7.2.2"
